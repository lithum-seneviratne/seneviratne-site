---
import Layout from "../components/Layout.astro";

const pageTitle = "About";
---

<Layout pageTitle={pageTitle}>
    <main class="flex h-min-screen grow flex-col justify-end items-center text-ink-dim">
        <section class="h-auto w-full mt-10 overflow-hidden bg-void md:pt-0 sm:pt-16 2xl:pt-16">
                <div class="px-4 mx-auto sm:px-6 lg:px-8 max-w-7xl">
                    <div class="grid items-center grid-cols-1 md:grid-cols-2">

                        <div class="bg-panel p-5 rounded-lg">
                            <h2 class="text-2xl font-bold leading-tight text-ink sm:text-4xl lg:text-5xl"> Hi, I'm Lithum!
                            </h2>
                            <p class="max-w-lg mt-3 text-xl leading-relaxed md:mt-8">
                                Amet minim mollit non deserunt
                                ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim velit mollit.
                                Exercitation veniam consequat sunt nostrud amet.
                            </p>
                        </div>

                        <div>
                            <img class="relative w-full xl:max-w-lg xl:mx-auto 2xl:origin-bottom 2xl:scale-100" src="/public/IMG_5157_Transparent_cropped.png" alt="" />
                        </div>

                    </div>
                </div>
        </section>
    </main>
</Layout>