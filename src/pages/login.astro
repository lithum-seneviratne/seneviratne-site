---
import Layout from "../components/Layout.astro";

const pageTitle = "Login";
---

<Layout pageTitle={pageTitle}>
    <main class="fixed inset-0 flex items-center justify-center -z-9">
        <form method="POST" action="/api/login" class="loginForm flex flex-col items-center gap-2 p-6 rounded-3xl overflow-hidden">
            <h1 class="text-4xl text-white py-6">Dashboard Login</h1>
            <br>
            <input type="password" name="password" required autofocus class="loginButton"/>
            <br>
            <button type="submit" class="loginButton">Submit</button>
        </form>
    </main>
</Layout>