---
import Layout from "../components/Layout.astro";

const pageTitle = "Login";
---

<Layout pageTitle={pageTitle}>
    <main class="flex grow justify-center items-center text-ink-dim min-h-screen">
        <form method="POST" action="/api/login" class="loginForm flex flex-col items-center gap-2 p-6 rounded-3xl overflow-hidden">
            <h1 class="text-4xl text-ink py-2">Login</h1>
            <br>
            <div class="sr-only">
                <label for="username">Username</label>
                
            </div>
            <input 
                type="password" 
                name="password" 
                id="password" 
                autocomplete="current-password"
                required 
                autofocus 
                class="mt-4 ml-2 inline-block rounded-md border border-edge-strong px-4 py-2 text-sm hover:border-lamp focus:outline-none focus:border-lamp-hover"
            />
            <!-- <input type="password" name="password" id="password" required autofocus class="mt-4 ml-2 inline-block rounded-md border border-edge-strong px-4 py-2 text-sm hover:border-lamp focus:outline-none focus:border-lamp-hover"/> -->
            <br>
            <button type="submit" class="bg-panel text-ink-dim border border-ink-dim mt-5 w-fit rounded-md px-4 py-2 text-md font-mono cursor-pointer shadow-md transition-transform hover:scale-105 hover:bg-lamp-hover hover:border-void hover:text-void">Submit</button>
        </form>
    </main>
</Layout>